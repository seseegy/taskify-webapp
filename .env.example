# Salin file ini menjadi `.env.local` lalu isi nilainya.
# Semua variabel VITE_* ikut ter-bundle ke browser → HANYA isi nilai yang memang publik.
# JANGAN taruh service_role key Supabase atau key Cloudflare R2 di sini.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# PowerSync Dashboard → instance → Connect
VITE_POWERSYNC_URL=https://<instance-id>.powersync.journeyapps.com

# Opsional — notifikasi pengingat. Buat dengan `pnpm vapid:generate` (lihat docs/SETUP.md §7)
VITE_VAPID_PUBLIC_KEY=

# Opsional — pemutar musik. Asal Worker music-taskify, TANPA garis miring di akhir.
# Kosongkan untuk menyembunyikan seluruh pintu masuk musik; aplikasi tetap jalan normal.
# Ini hanya URL, bukan rahasia: autentikasinya memakai JWT sesi Supabase pengguna, jadi
# tidak ada token yang perlu dibundel ke browser. Lihat docs/RANCANGAN-MUSIK.md.
VITE_MUSIC_API_URL=
