{
  "name": "taskify-webapp",
  "private": true,
  "version": "0.1.0",
  "description": "Taskify — aplikasi produktivitas pribadi: tugas, jurnal, keuangan, kalender, dan vault kode. Offline-first (PWA).",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:contrast && pnpm test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "pwa:icons": "pwa-assets-generator",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs",
    "fn:deploy": "supabase functions deploy send-reminders --no-verify-jwt",
    "fn:deploy:files": "supabase functions deploy files --no-verify-jwt",
    "fn:deploy:tempfiles": "supabase functions deploy tempfiles --no-verify-jwt",
    "db:new": "supabase migration new",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/supabase.types.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@journeyapps/wa-sqlite": "^2.0.6",
    "@powersync/drizzle-driver": "^0.8.0",
    "@powersync/react": "^2.0.2",
    "@powersync/web": "^2.4.2",
    "@supabase/supabase-js": "^2.117.2",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-id": "^4.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.52.0",
    "prism-react-renderer": "^2.4.1",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "rrule": "^2.8.1",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1",
    "wrangler": "4.147.0"
  }
}
